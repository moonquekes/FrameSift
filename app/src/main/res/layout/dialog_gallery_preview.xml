<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/gallery_background">
    <com.davemorrissey.labs.subscaleview.SubsamplingScaleImageView android:id="@+id/previewOriginal" android:layout_width="match_parent" android:layout_height="match_parent"/>
    <ImageView android:id="@+id/previewQuick" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="@string/gallery_photo"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:layout_gravity="top" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:background="#B8101618">
        <TextView android:id="@+id/previewBack" android:layout_width="64dp" android:layout_height="48dp" android:gravity="center_vertical" android:text="@string/gallery_back" android:textSize="14sp" android:textColor="@color/gallery_text" android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/previewPosition" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="@color/gallery_text" android:textSize="13sp"/>
        <TextView android:id="@+id/previewExifToggle" android:layout_width="64dp" android:layout_height="40dp" android:gravity="center" android:text="@string/gallery_exif_symbol" android:contentDescription="@string/gallery_exif_toggle" android:textSize="12sp" android:textColor="@color/gallery_chip_text" android:background="@drawable/gallery_chip" android:clickable="true" android:focusable="true"/>
    </LinearLayout>
    <TextView android:id="@+id/previewLoading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal|top" android:layout_marginTop="84dp" android:background="@drawable/gallery_badge" android:textColor="@color/gallery_accent" android:textSize="12sp"/>
    <TextView android:id="@+id/previewLoadOriginal" android:layout_width="120dp" android:layout_height="44dp"
        android:layout_gravity="center_horizontal|top" android:layout_marginTop="120dp"
        android:gravity="center" android:background="@drawable/gallery_chip" android:textColor="@color/gallery_chip_text"
        android:textSize="13sp" android:text="@string/gallery_view_original" android:clickable="true" android:focusable="true" />
    <TextView android:id="@+id/previewExif" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:layout_marginBottom="104dp" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:padding="12dp" android:background="@drawable/gallery_badge" android:textColor="@color/gallery_text" android:textSize="12sp" android:maxLines="8" android:ellipsize="end" android:visibility="gone"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="100dp" android:layout_gravity="bottom" android:gravity="center" android:paddingStart="24dp" android:paddingEnd="24dp" android:background="#C8101618">
        <TextView android:id="@+id/previewPrevious" android:layout_width="56dp" android:layout_height="56dp" android:gravity="center" android:text="@string/gallery_previous_symbol" android:contentDescription="@string/gallery_previous" android:textColor="@color/gallery_text" android:textSize="36sp" android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/previewPick" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="24dp" android:layout_marginEnd="24dp" android:gravity="center" android:background="@drawable/gallery_chip" android:textColor="@color/gallery_chip_text" android:textSize="14sp" android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/previewNext" android:layout_width="56dp" android:layout_height="56dp" android:gravity="center" android:text="@string/gallery_next_symbol" android:contentDescription="@string/gallery_next" android:textColor="@color/gallery_text" android:textSize="36sp" android:clickable="true" android:focusable="true"/>
    </LinearLayout>
</FrameLayout>
